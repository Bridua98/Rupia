{
  "name": "rupia",
  "private": true,
  "scripts": {
    "build": "webpack --config ui/webpack.config.js --mode production",
    "watch": "webpack --config ui/webpack.config.js --mode development --watch",
    "django": "uv run python manage.py runserver 0.0.0.0:8000",
    "sync": "browser-sync start --proxy localhost:8000 --files \"templates/**/*.html, static/webpack_bundles/**/*\" --no-open --no-notify --port 3000",
    "dev": "concurrently -n django,webpack,sync -c blue,yellow,green \"npm run django\" \"npm run watch\" \"npm run sync\""
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@xyflow/react": "^12.3.5",
    "bootstrap": "^5.3.3",
    "cmdk": "^1.0.4",
    "htmx.org": "^2.0.4",
    "jquery": "^3.7.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.28.0",
    "vaul": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "babel-loader": "^9.2.1",
    "browser-sync": "^3.0.3",
    "concurrently": "^9.1.0",
    "css-loader": "^7.1.2",
    "mini-css-extract-plugin": "^2.9.2",
    "sass": "^1.80.6",
    "sass-loader": "^16.0.3",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4"
  }
}
