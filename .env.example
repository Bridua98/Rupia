DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Sin DB_ENGINE el entorno local usa SQLite. Con Docker Compose, MySQL 8.
DB_ENGINE=mysql
DB_NAME=rupia
DB_USER=rupia
DB_PASSWORD=rupia
DB_HOST=127.0.0.1
DB_PORT=3306

