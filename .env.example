DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes extra para CSRF. En desarrollo, BrowserSync (:3000) ya está incluido.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Sin DB_ENGINE el entorno usa SQLite. DB_ENGINE=mysql usa MySQL en localhost.
DB_ENGINE=mysql
DB_NAME=rupia
DB_USER=rupia
DB_PASSWORD=rupia
DB_HOST=127.0.0.1
DB_PORT=3306

# Superusuario inicial de `make bootstrap`. En desarrollo estos son los valores
# por defecto; fuera de desarrollo la contraseña es obligatoria.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@rupia.local
DJANGO_SUPERUSER_PASSWORD=Clave-inicial-Rupia-2026

AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
